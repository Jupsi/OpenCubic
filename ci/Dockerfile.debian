# Build/test image for aceflash on Debian.
#   docker build -f ci/Dockerfile.debian -t aceflash-debian .
#   docker run --rm -v "$PWD":/src:ro aceflash-debian
ARG DEBIAN=trixie
FROM debian:${DEBIAN}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        cmake ninja-build g++ qt6-base-dev libssl-dev unzip tar ca-certificates \
        qt6-qpa-plugins xvfb xauth fonts-dejavu-core ccache \
    && rm -rf /var/lib/apt/lists/*
ENV LANG=C.UTF-8
CMD ["bash", "-c", "cp -r /src/flashtool /w && cd /w && cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Debug && cmake --build build && ctest --test-dir build --output-on-failure"]
